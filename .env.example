# Copy to .env.local and fill in. Never prefix any of these with NEXT_PUBLIC_.

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Only needed locally if OAuth callbacks misbehave:
# AUTH_URL=http://localhost:3000

# Google Cloud OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The only Google account allowed to sign in
ALLOWED_EMAIL=you@example.com

# Encrypts the stored Google refresh token — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Neon Postgres pooled connection string (injected automatically when Neon is connected in Vercel)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Todoist → Settings → Integrations → Developer
TODOIST_API_TOKEN=

# Anthropic Console
ANTHROPIC_API_KEY=
# Any current Claude model ID, e.g. a Claude Sonnet model
ANTHROPIC_MODEL=claude-sonnet-4-5

# All "today / this week" logic uses this timezone (Vercel runs in UTC)
APP_TIMEZONE=America/Los_Angeles

# Calendar to read time blocks from
GOOGLE_CALENDAR_ID=primary
